import numpy as np

# Sales data for 3 products (3x3 matrix)
# Each row represents a different product
sales_data = np.array([
    [100, 150, 200],
    [250, 300, 350],
    [120, 180, 240]
])

# Calculate the average price of all products sold
average_price = np.mean(sales_data)

# Display the result
print("Average price of all products:", average_price)
