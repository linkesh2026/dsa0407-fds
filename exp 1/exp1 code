import numpy as np

# Marks of 4 students in the order:
# Math, Science, English, History
student_scores = np.array([
    [85, 90, 78, 88],
    [92, 85, 80, 75],
    [76, 95, 89, 84],
    [88, 87, 92, 90]
])

# Subject names
subjects = ["Math", "Science", "English", "History"]

# Calculate average marks for each subject (column-wise)
average_scores = np.mean(student_scores, axis=0)

# Display average scores
print("Average scores for each subject:")
for subject, average in zip(subjects, average_scores):
    print(f"{subject}: {average:.2f}")

# Find the subject with the highest average
highest_index = np.argmax(average_scores)

print("\nSubject with the highest average:",
      subjects[highest_index])
print("Highest average score:", average_scores[highest_index])
